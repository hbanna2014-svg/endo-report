{
  "name": "endoreport",
  "productName": "EndoReport",
  "version": "0.4.0",
  "description": "Offline Endoscopy & Colonoscopy Reporting Software for Windows",
  "author": "EndoReport",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5178 && cross-env ENDOREPORT_DEV=1 electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node scripts/selftest.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "release:win": "npm run build && electron-builder --win --x64 --publish always",
    "checksums": "node scripts/checksums.mjs release",
    "preview:hospital": "node scripts/hospital-preview.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "docx": "^8.5.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.endoreport.desktop",
    "productName": "EndoReport",
    "copyright": "EndoReport",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EndoReport-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EndoReport",
      "artifactName": "EndoReport-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hbanna2014-svg",
        "repo": "endo-report",
        "releaseType": "release"
      }
    ]
  }
}
